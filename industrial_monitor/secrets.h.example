// ============================================================
// secrets.h.example
// ------------------------------------------------------------
// Ini CONTOH/TEMPLATE. Aman diupload ke GitHub karena isinya
// cuma placeholder, bukan credential asli.
//
// CARA PAKAI:
// 1. Copy file ini, rename jadi "secrets.h"
// 2. Isi semua value di bawah dengan data asli kamu
// 3. Pastikan "secrets.h" TIDAK pernah di-upload/commit ke Git
//    (sudah otomatis diblokir lewat .gitignore)
// ============================================================

// ---- WiFi ----
#define SECRET_SSID          "your_wifi_ssid"
#define SECRET_PASSWORD      "your_wifi_password"

// ---- InfluxDB ----
#define SECRET_INFLUX_HOST   "your_influxhost"
#define SECRET_INFLUX_PORT   8086
#define SECRET_INFLUX_ORG    "your_org"
#define SECRET_INFLUX_BUCKET "your_bucket"
#define SECRET_INFLUX_TOKEN  "your_token"
